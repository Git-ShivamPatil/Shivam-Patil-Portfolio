# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it is already gitignored.

# ---- Site ----
# Canonical origin used for metadata, sitemap/robots, OG images, and links in emails.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---- Database (Neon Postgres) ----
# Pooled connection string (runtime queries) — hostname includes "-pooler".
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Direct connection string (Prisma Migrate) — hostname WITHOUT "-pooler".
DIRECT_URL="postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require"

# ---- NextAuth / Auth.js v5 ----
# Generate with: npx auth secret
AUTH_SECRET="replace-with-a-generated-secret"
AUTH_URL="http://localhost:3000"
# Required behind a reverse proxy (Vercel) so Auth.js trusts the forwarded host.
AUTH_TRUST_HOST="true"

# Google OAuth client (console.cloud.google.com)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# GitHub OAuth app (github.com/settings/developers)
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# ---- Email (Resend) ----
# Without this, transactional mail (password reset, contact, newsletter,
# booking confirmations) is logged to the console instead of sent.
RESEND_API_KEY=""
EMAIL_FROM="Shivam Patil <onboarding@resend.dev>"

# ---- Phase 5: integrations ----
# All optional. Each feature degrades gracefully when its variable is absent
# rather than erroring — see lib/integrations/cache.ts.

# GitHub stats on /stats. Works unauthenticated at 60 req/hr; a fine-grained
# read-only token (no scopes needed for public data) raises that to 5,000/hr.
GITHUB_USERNAME="Git-ShivamPatil"
GITHUB_TOKEN=""

# LeetCode stats on /stats. No API key exists — this is the public GraphQL
# endpoint, so only the username is needed.
LEETCODE_USERNAME="shivam2op"

# The location map on /reach-out needs no configuration: it embeds
# OpenStreetMap, which requires no account, no API key, and no payment method.
# Mapbox was considered and rejected — it is metered and bills past a free
# allowance, and nothing in this project should be able to generate a charge.

# Cal.com intro-call link on /services (free individual plan). Without
# CAL_USERNAME the section is not rendered at all.
CAL_USERNAME=""
CAL_EVENT_SLUG="30min"

# ---- Phase 6: web push (VAPID) ----
# Generate locally — no account required:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# The public key is served to browsers by /api/push/subscribe; the private key
# must never reach the client.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:shivampatilinfo@gmail.com"

# ---- Phase 7: payments ----
# Configure either provider, both, or neither. /services adapts to whatever is
# present; with none configured the booking API returns 503 and says so.
# INR defaults to Razorpay, everything else to Stripe (lib/payments/index.ts).

# Stripe — dashboard.stripe.com/test/apikeys
# STRIPE_WEBHOOK_SECRET comes from the webhook endpoint you create for
# POST /api/webhooks/stripe (events: checkout.session.completed,
# checkout.session.async_payment_succeeded/failed, charge.refunded).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Razorpay — dashboard.razorpay.com/app/website-app-settings/api-keys
# RAZORPAY_WEBHOOK_SECRET is the secret you choose when creating the webhook
# for POST /api/webhooks/razorpay (events: payment.captured, payment.failed,
# order.paid, refund.processed).
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
