generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

// No url/directUrl here — Prisma 7 configures the CLI's connection via
// prisma.config.ts and the runtime connection via the driver adapter
// (lib/prisma.ts), not the datasource block.
datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  emailVerified  DateTime?
  image          String?
  // Null for OAuth-only accounts — there's no password to hash.
  hashedPassword String?
  role           Role      @default(USER)

  accounts    Account[]
  sessions    Session[]
  resetTokens PasswordResetToken[]
  blogPosts   BlogPost[]

  pushSubscriptions PushSubscription[]
  chatConversation  ChatConversation?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Auth.js OAuth account linking (Google, GitHub, ...).
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// Required by @auth/prisma-adapter's types even though this project uses the
// JWT session strategy (mandatory for the Credentials provider) — no rows
// are actually written here, but the adapter references this model.
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Password-reset flow. Only a SHA-256 hash of the raw token is stored — the
// raw token only ever exists in the emailed link, never at rest.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---- Phase 3/4: content CMS, inbox, referrals ----

enum ProjectAccent {
  cyan
  violet
  orange
  lime
  blue
  pink
}

// Case-study projects shown on the homepage and /projects/[slug]. The
// tuple-shaped fields (implemented/architecture/steps) mirror the static
// shape the site was originally built around (see the pre-CMS app/projects.ts)
// and are stored as JSON rather than fully normalized — they're
// display-only nested content, not something that needs relational queries.
model Project {
  id          String        @id @default(cuid())
  slug        String        @unique
  number      String
  category    String
  title       String
  shortTitle  String
  summary     String        @db.Text
  outcome     String
  accent      ProjectAccent
  stack       String[]
  tags        String[]
  useCase     String        @db.Text
  // [title, description][]
  implemented Json
  // { title, detail, type: "input"|"core"|"store"|"output" }[]
  architecture Json
  // [title, description, command][]
  steps       Json
  published   Boolean       @default(true)
  order       Int           @default(0)

  images ProjectImage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, order])
}

model ProjectImage {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url       String
  alt       String  @default("")
  order     Int     @default(0)

  createdAt DateTime @default(now())

  @@index([projectId, order])
}

model BlogPost {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String    @db.Text
  content     String    @db.Text
  tags        String[]
  coverImage  String?
  published   Boolean   @default(false)
  publishedAt DateTime?

  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, publishedAt])
}

// Flat list rather than a separate SkillCategory table — categories are just
// a label grouping key (see app/skills.ts's original shape), not an entity
// that needs its own CRUD or relations.
model Skill {
  id       String @id @default(cuid())
  category String
  name     String
  order    Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([category, name])
  @@index([category, order])
}

enum MessageStatus {
  UNREAD
  READ
  ARCHIVED
}

// The admin "Inbox" — every /contact and /reach-out submission, persisted
// so a lead survives even if Resend isn't configured (see lib/mail.ts) or
// an email bounces. referralRef captures the P3 "Referrals" signal: which
// ?ref= source sent this lead in.
model ContactMessage {
  id          String        @id @default(cuid())
  name        String
  email       String
  message     String        @db.Text
  source      String        @default("contact")
  referralRef String?
  status      MessageStatus @default(UNREAD)

  createdAt DateTime @default(now())

  @@index([status, createdAt])
  @@index([referralRef])
}

// ---- Phase 5: third-party integrations ----

// Generic TTL cache for third-party API responses (GitHub, LeetCode).
//
// The row is deliberately NOT deleted at expiry: `expiresAt` only decides
// whether to attempt a refetch. When the upstream is down or rate-limiting —
// which LeetCode's unofficial GraphQL endpoint does regularly from serverless
// IPs — the last good payload is still served, so a stats panel degrades to
// "slightly stale" instead of "error".
model IntegrationCache {
  key       String   @id
  payload   Json
  fetchedAt DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
}

// ---- Phase 6: communication ----

enum SubscriptionStatus {
  PENDING
  CONFIRMED
  UNSUBSCRIBED
}

// Double opt-in: a row is created as PENDING and only becomes CONFIRMED after
// the emailed confirmToken is followed. Storing an unsubscribe token up front
// means every newsletter send can carry a working one-click unsubscribe link
// without minting state at send time.
model NewsletterSubscriber {
  id             String             @id @default(cuid())
  email          String             @unique
  status         SubscriptionStatus @default(PENDING)
  confirmToken   String             @unique
  unsubToken     String             @unique
  referralRef    String?
  confirmedAt    DateTime?
  unsubscribedAt DateTime?

  createdAt DateTime @default(now())

  @@index([status])
}

// Web Push endpoints (RFC 8030). endpoint is the natural key — the browser
// reissues the same one for a given subscription, so upserting on it keeps
// re-subscribes from piling up duplicate rows.
model PushSubscription {
  id       String @id @default(cuid())
  endpoint String @unique
  p256dh   String
  auth     String

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  userAgent  String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([userId])
}

enum ChatStatus {
  OPEN
  CLOSED
}

enum ChatAuthor {
  VISITOR
  OWNER
  SYSTEM
}

// One conversation per visitor. Anonymous visitors are identified by a signed
// cookie (guestId); signed-in users by userId. Both are unique and nullable so
// a guest conversation can be adopted by a user account on sign-in without
// creating a second thread.
model ChatConversation {
  id      String  @id @default(cuid())
  guestId String? @unique
  userId  String? @unique
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  visitorName  String?
  visitorEmail String?
  status       ChatStatus @default(OPEN)

  // Typing indicators as short-lived deadlines rather than booleans. A
  // boolean would need an explicit "stopped typing" write that a closed tab
  // never sends, leaving the indicator stuck on forever; a deadline in the
  // near future simply lapses. They live here rather than in memory because
  // each serverless invocation is a separate process — an in-memory flag set
  // by the POST would be invisible to the instance holding the SSE stream.
  visitorTypingUntil DateTime?
  ownerTypingUntil   DateTime?

  // Denormalised so the admin inbox can sort threads without aggregating
  // ChatMessage on every list render.
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())

  messages ChatMessage[]

  @@index([status, lastMessageAt])
}

// Typing indicators are deliberately absent here — they are sub-second
// ephemeral state, so they live in the in-memory hub (lib/realtime/hub.ts)
// and never touch Postgres.
model ChatMessage {
  id             String           @id @default(cuid())
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  author ChatAuthor
  body   String     @db.Text

  // Read receipts. deliveredAt is set on persist; readAt is set when the
  // *other* party acknowledges having seen it.
  deliveredAt DateTime  @default(now())
  readAt      DateTime?

  createdAt DateTime @default(now())

  @@index([conversationId, createdAt])
  @@index([conversationId, author, readAt])
}

// ---- Phase 7: monetization ----

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  REFUNDED
}

enum PaymentProvider {
  STRIPE
  RAZORPAY
}

enum PaymentStatus {
  CREATED
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

// A bookable engagement (consultation, architecture review, ...). Prices are
// held in the currency's minor unit (paise / cents) — never floats, so no
// rounding drift between what is charged and what is invoiced.
model ServiceOffering {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String  @db.Text
  durationMin Int
  priceMinor  Int
  currency    String  @default("INR")
  active      Boolean @default(true)
  order       Int     @default(0)

  bookings Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, order])
}

model Booking {
  id        String @id @default(cuid())
  // Human-facing identifier used in emails and invoices (BK-YYMM-XXXX).
  reference String @unique

  offeringId String
  offering   ServiceOffering @relation(fields: [offeringId], references: [id], onDelete: Restrict)

  name    String
  email   String
  company String?
  notes   String? @db.Text

  scheduledAt   DateTime?
  // Cal.com booking uid, when the slot was reserved through Cal.
  calBookingUid String?

  status      BookingStatus @default(PENDING_PAYMENT)
  referralRef String?
  userId      String?

  payments Payment[]
  invoice  Invoice?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([email])
}

model Payment {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  provider PaymentProvider
  // Provider-side order/session id: a Stripe Checkout Session id or a
  // Razorpay order id. Unique so a webhook can resolve a payment by it alone.
  providerOrderId   String  @unique
  providerPaymentId String? @unique

  amountMinor Int
  currency    String
  status      PaymentStatus @default(CREATED)

  // The blueprint's Idempotency-Key stage, applied at the command boundary:
  // retrying "create checkout for booking X" returns the existing payment
  // rather than charging twice.
  idempotencyKey String @unique

  rawPayload Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([bookingId])
}

model Invoice {
  id     String @id @default(cuid())
  number String @unique

  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  amountMinor Int
  taxMinor    Int    @default(0)
  currency    String

  // Snapshotted at issue time. An invoice is a historical record: it must not
  // change because the offering was later renamed or repriced.
  billTo    Json
  lineItems Json

  // Unguessable path segment, so a customer can open their invoice without an
  // account while an enumerated id cannot leak anyone else's.
  accessToken String @unique

  issuedAt DateTime @default(now())
}

// ---- Phase 8: growth ----

// A trackable short link: /r/<code> -> destination, with ?ref=<code> appended
// so the existing referral cookie (lib/referral.ts) picks it up. That is what
// connects a *click* to a *conversion* — a ContactMessage, Booking or
// NewsletterSubscriber carrying the same referralRef came from this link, so
// no separate attribution pipeline is needed.
model ReferralLink {
  id          String  @id @default(cuid())
  code        String  @unique
  label       String
  destination String
  campaign    String?
  active      Boolean @default(true)

  // Denormalised running total. The ReferralClick rows are the ledger and
  // stay authoritative; this exists so the admin list can sort and render
  // without a groupBy across every click ever recorded.
  clickCount  Int @default(0)
  uniqueCount Int @default(0)

  clicks ReferralClick[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, createdAt])
}

// One row per redirect served.
//
// No raw IP is stored. `visitorHash` is a salted SHA-256 of (ip + user-agent +
// UTC date), which is enough to tell two visits apart within a day without
// keeping anything that identifies a person — and it rotates daily, so the
// data cannot be re-joined into a long-term profile.
model ReferralClick {
  id     String       @id @default(cuid())
  linkId String
  link   ReferralLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  referer     String?
  userAgent   String?
  country     String?
  device      String  @default("unknown")
  visitorHash String
  isUnique    Boolean @default(true)

  createdAt DateTime @default(now())

  @@index([linkId, createdAt])
  @@index([createdAt])
  // Serves the "is this visitor new today?" lookup on the redirect path,
  // which has to stay fast — it runs before the 302 is issued.
  @@index([linkId, visitorHash])
}

// ---- Phase 9: storage ----

// An object stored in S3/R2, recorded here so the admin has a browsable
// library rather than a bucket it has to guess at, and so an upload that
// half-completed can be told apart from one that never started.
//
// `checksum` is the SHA-256 the client computed before requesting a presigned
// URL. Re-uploading a byte-identical file returns the existing asset instead
// of a second copy — worth doing when the free tier bills on stored bytes.
model MediaAsset {
  id          String @id @default(cuid())
  key         String @unique
  url         String
  filename    String
  contentType String
  bytes       Int
  checksum    String @unique

  width  Int?
  height Int?
  alt    String @default("")
  folder String @default("uploads")

  uploadedById String?

  createdAt DateTime @default(now())

  @@index([folder, createdAt])
}

// ---- Phase 10: analytics ----

// One row per page view.
//
// Privacy carries over unchanged from P8: no raw IP is ever written.
// `visitorHash` is the same salted, UTC-day-bucketed SHA-256, so a visitor can
// be counted once per day without the data being joinable across days. Geo is
// stored at city granularity at most — the resolution Vercel's edge headers
// already give us — and never alongside anything that identifies a person.
model PageView {
  id String @id @default(cuid())

  // Minted by the browser, one per navigation, and UNIQUE.
  //
  // This is the phase's idempotency key. The tracker flushes on `pagehide`
  // *and* on `visibilitychange`, because iOS fires only one of the two
  // depending on how the tab goes away — so the same view is regularly
  // reported twice. Keying on viewId means the second beacon updates the
  // engagement columns instead of inventing a second visit.
  viewId String @unique

  path         String
  referrerHost String?
  device       String  @default("unknown")

  country  String?
  region   String?
  city     String?
  timezone String?

  visitorHash String
  isUnique    Boolean @default(true)

  // The UTC date as "YYYY-MM-DD", written at ingest.
  //
  // Redundant against createdAt, and deliberately so. Prisma's groupBy has no
  // date truncation, which leaves two options for a daily chart: pull every
  // row in the window into the app and bucket in JS (what P8 does, and what
  // stops scaling the moment a page gets real traffic), or drop to raw SQL for
  // one query. Materialising the bucket key at write time is the third option
  // and costs 10 bytes a row — the read becomes a plain indexed groupBy whose
  // cost is proportional to the number of *days* shown, not to traffic.
  day String

  // Patched in by the final beacon: milliseconds the tab was actually visible
  // (not wall-clock — a backgrounded tab is not a reader), and the deepest
  // scroll position reached as a percentage of document height.
  durationMs  Int @default(0)
  scrollDepth Int @default(0)

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([day])
  @@index([path, createdAt])
  @@index([country, createdAt])
  // Serves "has this visitor been seen today?", which runs on the ingest path
  // before the row is written.
  @@index([visitorHash, createdAt])
}

enum AnalyticsEventType {
  CLICK
  DOWNLOAD
  OUTBOUND
  RAGE
}

// The interaction ledger: one row per tracked click, download or outbound
// navigation. Kept alongside the rolled-up AnalyticsCounter for the same
// reason ReferralClick is kept alongside ReferralLink.clickCount — the ledger
// answers "when, from where, on what device", the counter answers "how many"
// without a groupBy over every event ever recorded.
model AnalyticsEvent {
  id   String             @id @default(cuid())
  type AnalyticsEventType

  path String
  // Stable identity for the thing interacted with: a data-analytics-id, a
  // download slug, or an outbound hostname. Never free-form user text.
  target String
  label  String?

  device      String  @default("unknown")
  country     String?
  visitorHash String

  createdAt DateTime @default(now())

  @@index([type, createdAt])
  @@index([target, createdAt])
  @@index([path, createdAt])
}

// Rolled-up totals per (kind, key) — downloads, outbound destinations, tracked
// UI elements. Denormalised on purpose: the admin page reads these directly,
// so adding a hundred thousand events never slows the dashboard down.
model AnalyticsCounter {
  id    String @id @default(cuid())
  kind  String
  key   String
  label String @default("")

  total       Int @default(0)
  uniqueTotal Int @default(0)

  lastAt    DateTime @default(now())
  createdAt DateTime @default(now())

  @@unique([kind, key])
  @@index([kind, total])
}

// Click heatmap, stored as a sparse aggregate rather than as raw points.
//
// A row per click coordinate is unbounded and, worse, is a re-identification
// surface: an exact (x, y, timestamp) trail is a behavioural fingerprint. This
// stores only a counter per grid cell, so the table's ceiling is
// paths x devices x cells and no individual path through the page survives.
// Cells are created lazily, so in practice it holds only the handful of cells
// anyone has actually clicked.
//
// x is normalised against the centred content column and y against total
// document height — see lib/analytics/constants.ts for why.
model HeatmapCell {
  id String @id @default(cuid())

  path String
  // Layout differs enough between form factors that cells are not comparable
  // across them; mixing a phone's single column into a desktop grid would
  // smear the map rather than add to it.
  device String
  x      Int
  y      Int

  count Int @default(0)

  updatedAt DateTime @updatedAt

  @@unique([path, device, x, y])
  @@index([path, device])
}

// ---- Phase 11: realtime ----

enum PresenceRole {
  VISITOR
  OWNER
}

// Who is on the site right now.
//
// This table exists because module-scope memory is not shared between
// serverless invocations: a Set of "currently connected" tokens held by the
// instance serving the heartbeat is invisible to the instance rendering the
// live dashboard, so presence has to be state, not memory. Postgres is the
// only store both instances can see.
//
// `token` is minted per *document*, held only in the page's own module scope,
// and never written to storage — so it dies with the tab and is never reused.
// That is deliberately weaker than the daily-rotating `visitorHash` P8/P10 use:
// presence answers "how many tabs are open on this path right now", a question
// that must not survive the visit. Nothing here is joinable to a PageView, a
// ReferralClick or a person.
//
// Liveness is a freshness window on `lastSeenAt` (PRESENCE_TTL_MS) rather than
// an online boolean, for the same reason ChatConversation stores typing
// deadlines rather than flags: a closed laptop never sends "I left", so a flag
// would stay true forever while a deadline simply lapses.
model PresenceSession {
  id    String       @id @default(cuid())
  token String       @unique
  role  PresenceRole @default(VISITOR)

  path    String  @default("/")
  device  String  @default("unknown")
  country String?
  userId  String?

  startedAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  // Serves the only two reads there are: "who is fresh" and "is the owner
  // fresh", both of which are a range scan on lastSeenAt.
  @@index([lastSeenAt])
  @@index([role, lastSeenAt])
}

// ---- Phase 16: AI ----

// One retrievable passage of the site, with its embedding.
//
// Chunks rather than whole documents: a project case study is long enough that
// a single vector for it averages away the specific thing someone asked about.
// Splitting on headings keeps each vector about one idea and gives the answer a
// section to cite.
//
// `embedding` is a pgvector column, declared Unsupported because Prisma has no
// native vector type. That means it can only be read and written through raw
// SQL — which is fine, since the only queries that touch it are the `<=>`
// distance search and the indexer's insert, and both are tagged templates.
// The extension has to exist before this table can be created: `pnpm ai:index`
// runs CREATE EXTENSION IF NOT EXISTS vector before anything else.
//
// Retrieval degrades if the column or extension is missing — see
// lib/ai/retrieve.ts, which falls back to Postgres full-text search alone
// rather than failing the request.
model KnowledgeChunk {
  id String @id @default(cuid())

  // "project" | "blog" | "skill" | "experience" | "page" | "resume"
  source   String
  sourceId String
  /// Where a citation should link to.
  url      String
  title    String
  /// The section this passage came from. Never null, and that matters: Postgres
  /// treats NULLs as distinct inside a unique index, so a nullable heading would
  /// let (source, sourceId, NULL) be inserted twice and quietly duplicate a
  /// chunk on every reindex. Sections without a heading get "Overview".
  heading  String   @default("Overview")

  content String @db.Text
  /// Term count after tokenisation — used to skip chunks too short to rank.
  tokens  Int    @default(0)

  embedding Unsupported("vector(256)")?

  /// SHA-256 of the content, so an unchanged chunk is not re-embedded.
  contentHash String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One chunk per (source, id, heading). A document that loses a heading on
  // re-index has its old chunk deleted rather than orphaned.
  @@unique([source, sourceId, heading])
  @@index([source])
}

// The IDF snapshot the index was built with, and nothing else.
//
// It has to be stored because a query vector weighted with different IDF values
// than the documents is a query in a different vector space — the numbers would
// still come out, and they would be meaningless. Storing it here is also what
// makes reindexing an all-or-nothing rebuild: changing IDF changes every vector,
// so there is no such thing as updating one row.
model KnowledgeIndex {
  // Single row, always.
  id String @id @default("singleton")

  documentCount Int
  /// term -> document frequency.
  idf           Json
  chunkCount    Int      @default(0)
  /// False when pgvector was unavailable and the index is lexical-only.
  vectorized    Boolean  @default(false)
  builtAt       DateTime @default(now())
}

// Webhook idempotency ledger. Both Stripe and Razorpay redeliver on any
// non-2xx, and Stripe explicitly warns that events can arrive more than once —
// the unique (provider, eventId) is what makes handling exactly-once.
model WebhookEvent {
  id       String @id @default(cuid())
  provider String
  eventId  String
  type     String

  processedAt DateTime @default(now())

  @@unique([provider, eventId])
  @@index([provider, processedAt])
}

// ---- Phase 18: distributed systems ----

enum OutboxStatus {
  PENDING
  DONE
  DEAD
}

// The transactional outbox.
//
// The blueprint names Kafka with a dead-letter queue. There is no Kafka here
// and there should not be: a broker is a server that must stay up, and this
// runs on functions that do not. What a broker is *for* in this design is the
// guarantee that "the row was written" and "the side effect happened" cannot
// disagree — and that guarantee comes from writing the event in the same
// transaction as the row, not from the broker.
//
// So the event is a row. A worker drains it with backoff, and anything that
// fails enough times lands in DEAD rather than being retried forever or
// dropped silently. That is the DLQ, and it is the part of the pattern that
// actually carries the weight.
model OutboxEvent {
  id      String @id @default(cuid())
  /// "contact.received", "booking.confirmed", ... — the routing key.
  topic   String
  payload Json

  status   OutboxStatus @default(PENDING)
  attempts Int          @default(0)
  /// Exponential backoff. A row is invisible to the worker until this passes.
  nextAttemptAt DateTime @default(now())
  /// Only ever the message, never the payload — it may contain a visitor's text.
  lastError String?

  createdAt   DateTime  @default(now())
  processedAt DateTime?

  // Serves the worker's only query: "what is due, oldest first".
  @@index([status, nextAttemptAt])
  @@index([topic, createdAt])
}

// Replay protection for state-changing requests.
//
// P7 already keys payment creation on an idempotency key, which is where it
// matters most. This generalises it: a client may send `Idempotency-Key` on any
// POST, and a retry with the same key returns the first response rather than
// performing the action twice.
//
// The stored response is what makes it useful. Returning 409 on a repeat would
// be correct and useless — the client retried because it never saw the first
// answer, so the only helpful reply is that answer.
model IdempotencyRecord {
  /// The client's key, scoped by route so two endpoints cannot collide.
  key   String @id
  route String

  /// SHA-256 of the request body. A key reused with different content is a bug
  /// on the caller's side, and answering it with the old response would hide it.
  requestHash String

  status   Int
  response Json

  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
}

// A named lease, held by one holder at a time.
//
// This is the lock the cron jobs take. Redis Redlock is implemented alongside
// it (lib/distsys/redlock.ts) because the blueprint names it, but this is the
// stronger option *here* and is the default: the work being guarded is Postgres
// work, so a lease in Postgres cannot be held while the database that the
// critical section writes to is unreachable. A Redis lock can.
model Lease {
  name      String   @id
  /// Random per acquisition. A releaser must present it, so a process whose
  /// lease already expired cannot release the next holder's.
  token     String
  holder    String
  expiresAt DateTime

  acquiredAt DateTime @default(now())

  @@index([expiresAt])
}
