generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

// No url/directUrl here — Prisma 7 configures the CLI's connection via
// prisma.config.ts and the runtime connection via the driver adapter
// (lib/prisma.ts), not the datasource block.
datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  emailVerified  DateTime?
  image          String?
  // Null for OAuth-only accounts — there's no password to hash.
  hashedPassword String?
  role           Role      @default(USER)

  accounts    Account[]
  sessions    Session[]
  resetTokens PasswordResetToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Auth.js OAuth account linking (Google, GitHub, ...).
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// Required by @auth/prisma-adapter's types even though this project uses the
// JWT session strategy (mandatory for the Credentials provider) — no rows
// are actually written here, but the adapter references this model.
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Password-reset flow. Only a SHA-256 hash of the raw token is stored — the
// raw token only ever exists in the emailed link, never at rest.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
