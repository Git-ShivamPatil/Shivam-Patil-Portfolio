generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

// No url/directUrl here — Prisma 7 configures the CLI's connection via
// prisma.config.ts and the runtime connection via the driver adapter
// (lib/prisma.ts), not the datasource block.
datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  emailVerified  DateTime?
  image          String?
  // Null for OAuth-only accounts — there's no password to hash.
  hashedPassword String?
  role           Role      @default(USER)

  accounts    Account[]
  sessions    Session[]
  resetTokens PasswordResetToken[]
  blogPosts   BlogPost[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Auth.js OAuth account linking (Google, GitHub, ...).
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// Required by @auth/prisma-adapter's types even though this project uses the
// JWT session strategy (mandatory for the Credentials provider) — no rows
// are actually written here, but the adapter references this model.
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Password-reset flow. Only a SHA-256 hash of the raw token is stored — the
// raw token only ever exists in the emailed link, never at rest.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---- Phase 3/4: content CMS, inbox, referrals ----

enum ProjectAccent {
  cyan
  violet
  orange
  lime
  blue
  pink
}

// Case-study projects shown on the homepage and /projects/[slug]. The
// tuple-shaped fields (implemented/architecture/steps) mirror the static
// shape the site was originally built around (see the pre-CMS app/projects.ts)
// and are stored as JSON rather than fully normalized — they're
// display-only nested content, not something that needs relational queries.
model Project {
  id          String        @id @default(cuid())
  slug        String        @unique
  number      String
  category    String
  title       String
  shortTitle  String
  summary     String        @db.Text
  outcome     String
  accent      ProjectAccent
  stack       String[]
  tags        String[]
  useCase     String        @db.Text
  // [title, description][]
  implemented Json
  // { title, detail, type: "input"|"core"|"store"|"output" }[]
  architecture Json
  // [title, description, command][]
  steps       Json
  published   Boolean       @default(true)
  order       Int           @default(0)

  images ProjectImage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, order])
}

model ProjectImage {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url       String
  alt       String  @default("")
  order     Int     @default(0)

  createdAt DateTime @default(now())

  @@index([projectId, order])
}

model BlogPost {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String    @db.Text
  content     String    @db.Text
  tags        String[]
  coverImage  String?
  published   Boolean   @default(false)
  publishedAt DateTime?

  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, publishedAt])
}

// Flat list rather than a separate SkillCategory table — categories are just
// a label grouping key (see app/skills.ts's original shape), not an entity
// that needs its own CRUD or relations.
model Skill {
  id       String @id @default(cuid())
  category String
  name     String
  order    Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([category, name])
  @@index([category, order])
}

enum MessageStatus {
  UNREAD
  READ
  ARCHIVED
}

// The admin "Inbox" — every /contact and /reach-out submission, persisted
// so a lead survives even if Resend isn't configured (see lib/mail.ts) or
// an email bounces. referralRef captures the P3 "Referrals" signal: which
// ?ref= source sent this lead in.
model ContactMessage {
  id          String        @id @default(cuid())
  name        String
  email       String
  message     String        @db.Text
  source      String        @default("contact")
  referralRef String?
  status      MessageStatus @default(UNREAD)

  createdAt DateTime @default(now())

  @@index([status, createdAt])
  @@index([referralRef])
}
